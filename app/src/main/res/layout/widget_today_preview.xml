<?xml version="1.0" encoding="utf-8"?>
<!-- Shown only in the widget picker, never inside the app, so the overdraw check does not apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_preview_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_kcal_short"
        android:textColor="@color/widget_preview_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_kcal_short"
        android:textColor="@color/widget_preview_text"
        android:textSize="11sp" />

    <!-- RemoteViews cannot inflate a plain View, so the bar is an ImageView with a background. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:background="@color/widget_preview_button"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_preview_next_short"
        android:textColor="@color/widget_preview_text"
        android:textSize="12sp" />
</LinearLayout>
