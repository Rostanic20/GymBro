<?xml version="1.0" encoding="utf-8"?>
<!-- Shown only in the widget picker, never inside the app, so the overdraw check does not apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_kcal"
        android:textColor="@color/widget_preview_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_preview_track" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_preview_next"
        android:textColor="@color/widget_preview_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/widget_preview_button"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/widget_log_planned"
        android:textColor="@color/widget_preview_on_button"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
