selectProgram:
SELECT
    workout_day.id AS day_id,
    workout_day.name AS day_name,
    workout_day.emphasis,
    workout_day.iso_day_of_week,
    exercise.id AS exercise_id,
    exercise.name AS exercise_name,
    day_exercise.sets,
    day_exercise.rep_min,
    day_exercise.rep_max,
    day_exercise.rir_min,
    day_exercise.rir_max,
    day_exercise.rest_seconds,
    day_exercise.is_top,
    day_exercise.note,
    exercise.substitute,
    exercise.start_load_kg,
    exercise.increment_kg,
    exercise.progression
FROM workout_day
INNER JOIN day_exercise ON day_exercise.day_id = workout_day.id
INNER JOIN exercise ON exercise.id = day_exercise.exercise_id
ORDER BY workout_day.iso_day_of_week, day_exercise.position;
