CREATE TABLE exercise (
    id            INTEGER NOT NULL PRIMARY KEY,
    name          TEXT    NOT NULL UNIQUE,
    load_type     TEXT    NOT NULL,
    progression   TEXT    NOT NULL,
    start_load_kg REAL,
    increment_kg  REAL,
    bar_weight_kg REAL
);

CREATE TABLE exercise_alternative (
    exercise_id    INTEGER NOT NULL REFERENCES exercise(id),
    alternative_id INTEGER NOT NULL REFERENCES exercise(id),
    note           TEXT,
    PRIMARY KEY (exercise_id, alternative_id)
);

CREATE TABLE workout_day (
    id              INTEGER NOT NULL PRIMARY KEY,
    name            TEXT    NOT NULL,
    emphasis        TEXT    NOT NULL,
    iso_day_of_week INTEGER NOT NULL UNIQUE
);

CREATE TABLE day_exercise (
    day_id           INTEGER NOT NULL REFERENCES workout_day(id),
    position         INTEGER NOT NULL,
    exercise_id      INTEGER NOT NULL REFERENCES exercise(id),
    sets             INTEGER NOT NULL,
    rep_min          INTEGER NOT NULL,
    rep_max          INTEGER NOT NULL,
    rir_min          INTEGER NOT NULL,
    rir_max          INTEGER NOT NULL,
    rest_min_seconds INTEGER NOT NULL,
    rest_max_seconds INTEGER NOT NULL,
    is_top           INTEGER NOT NULL DEFAULT 0,
    note             TEXT,
    PRIMARY KEY (day_id, position)
);

