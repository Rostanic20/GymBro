selectProgram:
SELECT
    workout_day.id AS day_id,
    workout_day.name AS day_name,
    workout_day.emphasis,
    workout_day.iso_day_of_week,
    day_exercise.sets,
    day_exercise.rep_min,
    day_exercise.rep_max,
    day_exercise.rir_min,
    day_exercise.rir_max,
    day_exercise.rest_min_seconds,
    day_exercise.rest_max_seconds,
    day_exercise.is_top,
    day_exercise.note,
    exercise.id AS exercise_id,
    exercise.name AS exercise_name,
    exercise.load_type,
    exercise.progression,
    exercise.start_load_kg,
    exercise.increment_kg,
    exercise.bar_weight_kg
FROM workout_day
INNER JOIN day_exercise ON day_exercise.day_id = workout_day.id
INNER JOIN exercise ON exercise.id = day_exercise.exercise_id
ORDER BY workout_day.iso_day_of_week, day_exercise.position;

selectAlternatives:
SELECT
    exercise_alternative.exercise_id,
    alternative.id AS alternative_id,
    alternative.name AS alternative_name,
    exercise_alternative.note
FROM exercise_alternative
INNER JOIN exercise AS alternative ON alternative.id = exercise_alternative.alternative_id
ORDER BY exercise_alternative.exercise_id, alternative.name;

updateLoadSettings:
UPDATE exercise
SET start_load_kg = :startLoadKg, increment_kg = :incrementKg
WHERE id = :id;
