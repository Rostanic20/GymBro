CREATE TABLE food (
    id               INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name             TEXT    NOT NULL,
    kcal_per_100g    REAL    NOT NULL,
    protein_per_100g REAL    NOT NULL,
    carbs_per_100g   REAL    NOT NULL,
    fat_per_100g     REAL    NOT NULL,
    unit_name        TEXT,
    unit_grams       REAL
);

