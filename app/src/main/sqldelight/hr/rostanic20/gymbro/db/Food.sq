selectAll:
SELECT * FROM food ORDER BY is_favourite DESC, name COLLATE NOCASE;

selectById:
SELECT * FROM food WHERE id = ?;

insertFood:
INSERT INTO food(name, kcal_per_100g, protein_per_100g, carbs_per_100g, fat_per_100g, unit_name, unit_grams)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateFood:
UPDATE food
SET name = :name,
    kcal_per_100g = :kcalPer100g,
    protein_per_100g = :proteinPer100g,
    carbs_per_100g = :carbsPer100g,
    fat_per_100g = :fatPer100g,
    unit_name = :unitName,
    unit_grams = :unitGrams
WHERE id = :id;

setFavourite:
UPDATE food SET is_favourite = :favourite WHERE id = :id;

lastInsertRowId:
SELECT last_insert_rowid();

selectRecipeItems:
SELECT recipe.id AS recipe_id, recipe.name AS recipe_name, recipe_item.grams, food.*
FROM recipe
INNER JOIN recipe_item ON recipe_item.recipe_id = recipe.id
INNER JOIN food ON food.id = recipe_item.food_id
ORDER BY recipe.id, food.name;

selectLogForDate:
SELECT * FROM food_log WHERE date_epoch_day = ? ORDER BY meal_slot, id;

selectLogForMeal:
SELECT * FROM food_log WHERE date_epoch_day = ? AND meal_slot = ? ORDER BY id;

insertLog:
INSERT INTO food_log(date_epoch_day, meal_slot, food_id, name, grams, kcal, protein_g, carbs_g, fat_g, logged_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteLog:
DELETE FROM food_log WHERE id = ?;
